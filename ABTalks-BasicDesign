        if (["landing","dashboard","day","leaderboard","progress","profile"].includes(p)) {
          page = p;
          submitStatus = null;
          render();
        }
      });
    });

    $("#setupProfileBtn")?.addEventListener("click", openProfile);
    $("#profileClose")?.addEventListener("click", closeProfile);
    $("#profileCancel")?.addEventListener("click", closeProfile);
    $("#profileSave")?.addEventListener("click", saveProfile);
    $("#profileName")?.addEventListener("input", updateProfilePreview);
    $("#profileOverlay")?.addEventListener("click", e => { if(e.target.id === "profileOverlay") closeProfile(); });
    document.addEventListener("click", (e) => {
      if(e.target.closest("#connectGithubBtn")){ e.preventDefault(); connectGithub(); }
      if(e.target.closest("#openCertBtn") || e.target.closest("#dlCertFromProfile")){ e.preventDefault(); showCertificateModal(); }
    });

    $("#notifClose")?.addEventListener("click", closeNotifications);
    $("#notifMarkAll")?.addEventListener("click", markAllNotifsRead);
    $("#notifOverlay")?.addEventListener("click", e => { if(e.target.id === "notifOverlay") closeNotifications(); });

    $("#taskLockClose")?.addEventListener("click", hideTaskLock);
    $("#taskLockOverlay")?.addEventListener("click", (e) => { if(e.target.id === "taskLockOverlay") hideTaskLock(); });
    $("#waitClose")?.addEventListener("click", hideWaitPopup);
    $("#waitOverlay")?.addEventListener("click", (e) => { if(e.target.id === "waitOverlay") hideWaitPopup(); });
    $("#resetCancel")?.addEventListener("click", hideResetWarning);
    $("#resetConfirm")?.addEventListener("click", doFullReset);
    $("#resetOverlay")?.addEventListener("click", (e) => { if(e.target.id === "resetOverlay") hideResetWarning(); });
    document.addEventListener("keydown", (e) => {
      if(e.key === "Escape"){ hideTaskLock(); hideWaitPopup(); hideResetWarning(); closeNotifications(); closeProfile(); }
    });

    document.addEventListener("click", (e) => {
      const btn=e.target.closest("#setupProfileBtn,#setupProfileInline");
      if(btn){ e.preventDefault(); openProfile(); }
    });

    // ============================================================
    //  INIT
    // ============================================================
    (async function init(){
      state = await loadState();
      state.currentDay = Number(state.currentDay) || nextIncompleteDay();
      state.profile = { ...defaultState().profile, ...(state.profile || {}) };
      state.submissions = Array.isArray(state.submissions) ? state.submissions : [];
      state.badges = Array.isArray(state.badges) ? state.badges : [];
      state.weeklyActivity = Array.isArray(state.weeklyActivity) ? state.weeklyActivity : [3,1,5,2,4,0,3];
      state.quotes = Array.isArray(state.quotes) && state.quotes.length ? state.quotes : QUOTES;
      state.profile.xp = xpTotal();
      state.profile.initials = state.profile.initials || initialsFor(state.profile.name);
      state.profile.name = state.profile.name || "";
      state.profile.initials = state.profile.name ? (state.profile.initials || initialsFor(state.profile.name)) : "👨‍💻";
      state.profile.college = state.profile.college || "";
      state.profile.course = state.profile.course || "";
      state.profile.goal = state.profile.goal || "Software Developer";
      state.profile.level = xpLevel();
      state.profile.streak = computeStreak(state);
      state.profile.careerReadiness = careerReadiness();
      if(!state.currentDay || state.currentDay < 1 || state.currentDay > 60) state.currentDay = nextIncompleteDay();
      // Single source of truth for rank + list
      syncLeaderboardState();
      render();
      // Splash: JUST DO IT!!!!! then welcome
      setTimeout(()=>{
        const splash=$("#splash");
        if(splash){
          splash.classList.add("hide");
          splash.setAttribute("aria-hidden","true");
          setTimeout(()=>splash.remove(),600);
        }
      },2100);
    })();
</script>
</body>
</html>
