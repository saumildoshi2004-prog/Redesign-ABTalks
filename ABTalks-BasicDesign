  const youName=state.profile.name||"You";
  const you={
    name:youName,
    initials:state.profile.initials||(youName==="You"?"YO":youName.split(/\s+/).map(w=>w[0]).join("").slice(0,2).toUpperCase()),
    xp:xpTotal(),
    streak:computeStreak(),
    isYou:true
  };
  const others=LEADERBOARD_OTHERS.map(o=>({
    ...o,
    initials:o.name.split(" ").map(w=>w[0]).join("").slice(0,2).toUpperCase(),
    isYou:false
  }));
  // Sort by XP desc; if tie, put "you" after others with same XP so rank is consistent
  return[...others,you].sort((a,b)=>{
    if(b.xp!==a.xp) return b.xp-a.xp;
    if(a.isYou) return 1;
    if(b.isYou) return -1;
    return a.name.localeCompare(b.name);
  });
}
