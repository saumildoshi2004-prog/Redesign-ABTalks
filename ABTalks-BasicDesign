<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#060810" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="description" content="ABTalks — a 60-day coding challenge for Indian college developers. Ship one task a day, prove it on GitHub and LinkedIn, and walk away with a portfolio recruiters can actually check." />
<title>ABTalks · 60-Day Coding Challenge</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<style>
:root{
  --ink:#060810; --surface:#0C1220; --surface-2:#111a2c; --card:#131c30; --card-flat:rgba(255,255,255,0.025);
  --line:rgba(255,255,255,0.08); --line-strong:rgba(255,255,255,0.14);
  --indigo:#675EF2; --indigo-soft:#8B84F7; --violet:#A78BFA; --cyan:#22D3EE; --amber:#F5A524; --mint:#34D399; --rose:#FB7185;
  --paper:#F7F8FC; --dim:#9AA3B8; --dim-2:#6B7488;
  --grad-brand:linear-gradient(135deg,var(--indigo),var(--violet));
  --grad-cyan:linear-gradient(135deg,var(--cyan),var(--indigo));
  --font-display:'Space Grotesk',Inter,sans-serif; --font-body:'Inter',sans-serif; --font-mono:'JetBrains Mono',monospace;
  --r-sm:10px; --r-md:16px; --r-lg:22px; --r-xl:28px; --r-pill:999px;
  --shadow-1:0 8px 24px -10px rgba(0,0,0,.55); --shadow-2:0 24px 56px -16px rgba(0,0,0,.7);
  --ease:cubic-bezier(.22,1,.36,1); --nav-h:70px; --safe-b:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;height:100%;}
body{
  font-family:var(--font-body); background:var(--ink); color:var(--paper); line-height:1.55;
  min-height:100dvh; padding-bottom:calc(var(--nav-h) + var(--safe-b) + 10px);
  -webkit-tap-highlight-color:transparent; -webkit-font-smoothing:antialiased; overflow-x:hidden;
  background-image:radial-gradient(60% 40% at 15% 0%, rgba(103,94,242,.16), transparent 60%),radial-gradient(50% 35% at 100% 10%, rgba(34,211,238,.09), transparent 60%);
  background-attachment:fixed;
}
a{text-decoration:none;color:inherit;}
button,input,textarea{font:inherit;border:none;outline:none;background:none;color:inherit;}
button{cursor:pointer;}
input:focus-visible,button:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--cyan);outline-offset:2px;border-radius:6px;}
img,svg{display:block;max-width:100%;}
::selection{background:rgba(103,94,242,.4);color:#fff;}
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:rgba(103,94,242,.5);border-radius:20px;}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.container{width:100%;max-width:520px;margin:0 auto;padding:18px 18px 12px;}
.page{animation:pageIn .38s var(--ease) both;}
@keyframes pageIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

.boot{min-height:100dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;}
.boot-mark{font-family:var(--font-mono);font-weight:700;font-size:1.6rem;color:var(--indigo-soft);letter-spacing:-1px;}
.boot-bar{width:120px;height:3px;border-radius:10px;background:var(--surface-2);overflow:hidden;}
.boot-bar::after{content:'';display:block;width:40%;height:100%;background:var(--grad-brand);animation:bootSlide 1.1s ease-in-out infinite;}
@keyframes bootSlide{0%{transform:translateX(-100%);}100%{transform:translateX(340%);}}
.boot-txt{font-size:.78rem;color:var(--dim);letter-spacing:.2px;}

/* Splash — JUST DO IT */
.splash{
  position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:#070910;transition:opacity .55s ease,visibility .55s;
}
.splash.hide{opacity:0;visibility:hidden;pointer-events:none}
.splash-text{
  font-family:'Space Grotesk',Inter,sans-serif;font-weight:900;font-size:clamp(2rem,9vw,3.4rem);
  letter-spacing:-.02em;text-align:center;line-height:1.05;padding:0 20px;
  background:linear-gradient(135deg,#fff 20%,#a99fff 50%,#22d3ee 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  animation:splashPop .7s cubic-bezier(.22,1,.36,1) both;
}
.splash-sub{
  margin-top:14px;font-size:.78rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;
  color:rgba(255,255,255,.45);animation:splashFade .6s ease .35s both;
}
.splash-bar{
  margin-top:28px;width:90px;height:3px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden;
  animation:splashFade .5s ease .2s both;
}
.splash-bar span{
  display:block;height:100%;width:0;border-radius:99px;
  background:linear-gradient(90deg,#675ef2,#22d3ee);
  animation:splashLoad 1.6s ease .4s forwards;
}
@keyframes splashPop{
  0%{opacity:0;transform:scale(.82) translateY(12px)}
  60%{opacity:1;transform:scale(1.04) translateY(0)}
  100%{opacity:1;transform:scale(1)}
}
@keyframes splashFade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@keyframes splashLoad{to{width:100%}}

.bottom-nav{
  position:fixed;bottom:0;left:0;right:0;height:calc(var(--nav-h) + var(--safe-b));padding-bottom:var(--safe-b);
  background:rgba(6,8,16,.86);backdrop-filter:blur(22px) saturate(1.5);-webkit-backdrop-filter:blur(22px) saturate(1.5);
  border-top:1px solid var(--line);display:flex;justify-content:space-around;align-items:center;z-index:100;
}
.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-width:64px;height:54px;padding:6px 10px;border-radius:14px;font-size:10px;font-weight:600;letter-spacing:.2px;color:var(--dim);transition:color .2s var(--ease);position:relative;}
.nav-item i{font-size:19px;transition:transform .2s var(--ease),color .2s var(--ease);}
.nav-item.active{color:var(--indigo-soft);}
.nav-item.active i{color:var(--indigo-soft);transform:translateY(-1px);}
.nav-item:active{transform:scale(.93);}
.nav-dot{position:absolute;top:5px;right:14px;width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 3px rgba(6,8,16,.86);}

.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:18px;box-shadow:var(--shadow-1);margin-bottom:12px;}
.card.flat{background:var(--card-flat);box-shadow:none;}
.card.accent{border-color:rgba(103,94,242,.35);background:linear-gradient(180deg,rgba(103,94,242,.08),var(--card) 60%);}

.eyebrow{display:inline-flex;align-items:center;gap:7px;font-family:var(--font-mono);font-size:.68rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--indigo-soft);background:rgba(103,94,242,.12);border:1px solid rgba(103,94,242,.25);padding:6px 12px;border-radius:var(--r-pill);}
.eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--cyan);}

.badge{display:inline-flex;align-items:center;gap:5px;padding:4px 11px;border-radius:var(--r-pill);font-size:11px;font-weight:600;background:rgba(103,94,242,.14);color:var(--indigo-soft);border:1px solid rgba(103,94,242,.2);white-space:nowrap;}
.badge.success{background:rgba(52,211,153,.12);color:var(--mint);border-color:rgba(52,211,153,.24);}
.badge.warning{background:rgba(245,165,36,.12);color:var(--amber);border-color:rgba(245,165,36,.24);}
.badge.danger{background:rgba(251,113,133,.12);color:var(--rose);border-color:rgba(251,113,133,.22);}
.badge.mono{font-family:var(--font-mono);}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:14px 20px;border-radius:var(--r-pill);font-size:15px;font-weight:600;transition:transform .16s var(--ease),box-shadow .2s,opacity .2s;user-select:none;}
.btn:active:not(:disabled){transform:scale(.97);}
.btn:disabled{opacity:.4;pointer-events:none;}
.btn-primary{background:var(--grad-brand);color:#fff;box-shadow:0 10px 28px -10px rgba(103,94,242,.55);}
.btn-secondary{background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--paper);}
.btn-secondary:hover{background:rgba(255,255,255,.07);border-color:var(--line-strong);}
.btn-ghost{background:transparent;color:var(--dim);width:auto;padding:8px 4px;}
.btn-ghost:hover{color:var(--paper);}
.btn-sm{padding:10px 16px;font-size:13px;}

.progress{height:6px;background:var(--surface-2);border-radius:20px;overflow:hidden;}
.progress-fill{height:100%;border-radius:20px;background:var(--grad-cyan);transition:width .8s var(--ease);}

.streak-pill{display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:var(--r-pill);font-family:var(--font-mono);font-weight:700;background:rgba(245,165,36,.1);color:var(--amber);border:1px solid rgba(245,165,36,.22);}

.field-group{margin:10px 0;}
.field-label{display:block;font-size:11.5px;font-weight:600;color:var(--dim);margin:0 0 6px 4px;letter-spacing:.2px;}
.field{display:flex;align-items:center;gap:12px;background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-pill);padding:2px 16px;transition:border-color .2s,box-shadow .2s;}
.field:focus-within{border-color:var(--indigo);box-shadow:0 0 0 3px rgba(103,94,242,.15);}
.field.error{border-color:var(--rose);box-shadow:0 0 0 3px rgba(251,113,133,.12);}
.field i{color:var(--dim);font-size:1rem;width:18px;text-align:center;flex-shrink:0;}
.field input{flex:1;padding:12px 0;background:transparent;color:var(--paper);font-size:14px;font-weight:500;min-width:0;}
.field input::placeholder{color:var(--dim-2);font-weight:400;}
.field-hint{font-size:12px;color:var(--rose);margin:5px 0 0 16px;display:none;}
.field-hint.show{display:block;}

.chip{padding:8px 12px;border-radius:12px;font-size:12.5px;font-weight:500;background:rgba(255,255,255,.03);border:1px solid var(--line);color:var(--text-secondary,#CBD5E1);display:flex;align-items:center;gap:8px;}
.chip i{color:var(--mint);font-size:.8rem;}

.day-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:4px;}
.day-grid .cell{aspect-ratio:1;border-radius:4px;background:var(--surface-2);border:1px solid transparent;transition:transform .15s;}
.day-grid .cell.done{background:var(--grad-brand);}
.day-grid .cell.next{background:var(--surface-2);border-color:var(--cyan);}
.day-grid .cell:hover{transform:scale(1.18);}

.ring-wrap{position:relative;width:112px;height:112px;flex-shrink:0;}
.ring-wrap svg{transform:rotate(-90deg);}
.ring-track{fill:none;stroke:var(--surface-2);stroke-width:10;}
.ring-fill{fill:none;stroke:url(#ringGrad);stroke-width:10;stroke-linecap:round;transition:stroke-dashoffset 1s var(--ease);}
.ring-label{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.ring-label .pct{font-family:var(--font-mono);font-weight:700;font-size:1.3rem;}
.ring-label .lbl{font-size:9.5px;color:var(--dim);letter-spacing:.3px;text-transform:uppercase;}

.code-window{background:#080B14;border:1px solid var(--line-strong);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-2);}
.code-window-bar{display:flex;align-items:center;gap:7px;padding:11px 14px;background:rgba(255,255,255,.03);border-bottom:1px solid var(--line);}
.code-window-bar .dot{width:9px;height:9px;border-radius:50%;}
.code-window-bar .path{margin-left:8px;font-family:var(--font-mono);font-size:11px;color:var(--dim);}
.code-window-body{padding:16px;}
.terminal-line{font-family:var(--font-mono);font-size:12.5px;color:var(--dim);margin-top:10px;}
.terminal-line .prompt{color:var(--mint);}
.terminal-line.result{color:var(--cyan);}

.avatar{border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;color:#fff;flex-shrink:0;}

.timeline{position:relative;padding-left:26px;}
.timeline::before{content:'';position:absolute;left:6px;top:6px;bottom:6px;width:1.5px;background:linear-gradient(var(--indigo),transparent);}
.timeline-item{position:relative;padding-bottom:20px;}
.timeline-item:last-child{padding-bottom:0;}
.timeline-item::before{content:'';position:absolute;left:-26px;top:4px;width:9px;height:9px;border-radius:50%;background:var(--indigo-soft);box-shadow:0 0 0 4px rgba(103,94,242,.15);}

.faq-item{border-bottom:1px solid var(--line);}
.faq-item:last-child{border-bottom:none;}
.faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 2px;text-align:left;font-family:var(--font-display);font-weight:600;font-size:.92rem;}
.faq-q i{color:var(--dim);transition:transform .25s var(--ease);flex-shrink:0;}
.faq-item.open .faq-q i{transform:rotate(45deg);color:var(--indigo-soft);}
.faq-a-wrap{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s var(--ease);}
.faq-item.open .faq-a-wrap{grid-template-rows:1fr;}
.faq-a-inner{overflow:hidden;}
.faq-a{padding:0 2px 16px;color:var(--dim);font-size:.86rem;line-height:1.6;}

.stat-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:12px 0 4px;}
.stat{text-align:center;padding:13px 6px;border-radius:var(--r-md);background:var(--card-flat);border:1px solid var(--line);}
.stat i{font-size:1.05rem;margin-bottom:4px;}
.stat .val{font-family:var(--font-mono);font-weight:700;font-size:.92rem;}
.stat .lbl{font-size:.62rem;color:var(--dim);margin-top:2px;}

.scroll-x{display:flex;gap:8px;overflow-x:auto;padding:2px 2px 8px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
.scroll-x::-webkit-scrollbar{display:none;}
.scroll-x>*{flex:0 0 auto;scroll-snap-align:start;}

.badge-chip{display:flex;flex-direction:column;align-items:center;gap:6px;width:76px;text-align:center;}
.badge-chip .ic{width:52px;height:52px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;background:var(--grad-brand);color:#fff;box-shadow:0 8px 20px -8px rgba(103,94,242,.5);}
.badge-chip.locked .ic{background:var(--surface-2);color:var(--dim-2);box-shadow:none;}
.badge-chip .nm{font-size:10px;font-weight:600;line-height:1.3;}
.badge-chip.locked .nm{color:var(--dim-2);}

.day-strip{display:flex;gap:6px;overflow-x:auto;padding:2px 2px 6px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);}
.day-strip::-webkit-scrollbar{display:none;}
.day-dot{flex:0 0 auto;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:12px;font-weight:600;background:var(--surface-2);color:var(--dim);border:1.5px solid transparent;scroll-snap-align:center;transition:all .2s var(--ease);}
.day-dot.current{background:var(--grad-brand);color:#fff;box-shadow:0 4px 14px rgba(103,94,242,.4);transform:scale(1.1);}
.day-dot.done{background:rgba(52,211,153,.12);color:var(--mint);border-color:rgba(52,211,153,.3);}

.toast-wrap{position:fixed;top:max(16px,env(safe-area-inset-top));left:50%;transform:translateX(-50%) translateY(-130%);z-index:300;transition:transform .4s var(--ease);pointer-events:none;}
.toast-wrap.show{transform:translateX(-50%) translateY(0);}
.toast{background:rgba(12,18,32,.95);border:1px solid var(--line-strong);padding:11px 18px;border-radius:var(--r-pill);font-size:13px;font-weight:500;box-shadow:var(--shadow-2);backdrop-filter:blur(16px);white-space:nowrap;display:flex;align-items:center;gap:8px;}
.confetti-layer{position:fixed;inset:0;pointer-events:none;z-index:250;overflow:hidden;}
@keyframes confettiFall{0%{transform:translateY(0) rotate(0) scale(1);opacity:1;}100%{transform:translateY(110vh) rotate(720deg) scale(.2);opacity:0;}}

.success-banner{margin-top:12px;padding:13px 14px;background:rgba(52,211,153,.09);border-radius:14px;border-left:3px solid var(--mint);display:flex;align-items:center;gap:10px;}
.error-banner{margin-top:12px;padding:13px 14px;background:rgba(251,113,133,.09);border-radius:14px;border-left:3px solid var(--rose);color:var(--rose);font-size:.86rem;}

.quote-card{background:linear-gradient(135deg,rgba(103,94,242,.08),rgba(34,211,238,.04));border:1px solid rgba(103,94,242,.14);border-radius:var(--r-lg);padding:16px 18px;font-style:italic;font-size:.9rem;color:#E2E8F0;line-height:1.6;}

h1,h2,h3,h4{font-family:var(--font-display);letter-spacing:-.01em;}
.flex{display:flex;}
.flex-between{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;}
.flex-center{display:flex;align-items:center;justify-content:center;}
.gap-1{gap:8px;} .gap-2{gap:12px;} .gap-3{gap:16px;}
.text-muted{color:var(--dim);} .text-dim2{color:var(--dim-2);}
.text-sm{font-size:.85rem;} .text-xs{font-size:.74rem;}
.mono{font-family:var(--font-mono);}
.fw-6{font-weight:600;} .fw-7{font-weight:700;}
.mt-1{margin-top:8px;} .mt-2{margin-top:16px;} .mb-1{margin-bottom:8px;}
.truncate{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.divider{height:1px;background:var(--line);margin:14px 0;border:none;}
.section-head{margin:26px 0 12px;}
.section-head .eyebrow{margin-bottom:10px;}
.section-head h2{font-size:1.4rem;font-weight:700;letter-spacing:-.02px;}
.grid-2{display:grid;grid-template-columns:1fr;gap:10px;}
.empty{text-align:center;padding:30px 12px;color:var(--dim);}
.empty i{font-size:2.2rem;opacity:.2;margin-bottom:8px;}

@media (min-width:640px){
  .container{max-width:600px;padding:26px 26px 16px;}
  .bottom-nav{max-width:600px;left:50%;transform:translateX(-50%);border-radius:22px 22px 0 0;border-left:1px solid var(--line);border-right:1px solid var(--line);}
  .grid-2{grid-template-columns:1fr 1fr;}
  .stat-row{grid-template-columns:repeat(3,1fr);}
}
@media (min-width:900px){
  .container{max-width:760px;padding:32px 32px 20px;}
  .bottom-nav{max-width:640px;}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;}
  .hero-grid .code-window{margin-top:0;}
}

/* Task lock modal */
.task-lock-overlay{position:fixed;inset:0;background:rgba(2,6,23,.72);backdrop-filter:blur(5px);display:none;align-items:center;justify-content:center;padding:20px;z-index:9999}
.task-lock-overlay.show{display:flex}
.task-lock-modal{width:min(420px,100%);background:var(--surface,#0f172a);border:1px solid rgba(99,102,241,.35);border-radius:20px;padding:24px;box-shadow:0 20px 70px rgba(0,0,0,.45);text-align:center}
.task-lock-icon{font-size:2.5rem;margin-bottom:8px}
.task-lock-modal h3{margin:0 0 8px;font-size:1.25rem}
.task-lock-modal p{margin:0 0 18px;color:#94a3b8;line-height:1.55;font-size:.9rem}
.task-lock-modal .btn{width:100%}
.task-number{display:inline-flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 8px;border-radius:10px;background:rgba(99,102,241,.14);border:1px solid rgba(99,102,241,.3);margin-right:8px;font-weight:800}
.info-item{display:flex;gap:9px;align-items:flex-start;margin:7px 0}
.info-item .info-emoji{width:24px;flex:none}
