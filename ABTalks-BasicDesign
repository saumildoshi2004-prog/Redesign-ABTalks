let waitCountdownTimer=null;
function hoursLeftUntilNextSubmit(){
  const last=state.lastSubmitAt ? new Date(state.lastSubmitAt).getTime() : 0;
  if(!last) return 0;
  const ms=24*60*60*1000 - (Date.now()-last);
  return ms>0 ? ms : 0;
}
function canSubmitNextDay(){
  return hoursLeftUntilNextSubmit()<=0;
}
function formatCountdown(ms){
  if(ms<=0) return "00:00:00";
  const totalSec=Math.floor(ms/1000);
  const h=Math.floor(totalSec/3600);
  const m=Math.floor((totalSec%3600)/60);
  const s=totalSec%60;
  return String(h).padStart(2,"0")+":"+String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
}
function updateWaitCountdown(){
  const el=$("#waitCountdown");
  if(!el) return;
  const ms=hoursLeftUntilNextSubmit();
  el.textContent=formatCountdown(ms);
  if(ms<=0){
    el.textContent="00:00:00";
    el.style.color="var(--mint,#4ade80)";
    stopWaitCountdown();
    const msg=$("#waitMessage");
    if(msg) msg.textContent="Your next challenge is unlocked. You can continue now.";
    const btn=$("#waitClose");
    if(btn) btn.textContent="Continue";
  }
}
function startWaitCountdown(){
  stopWaitCountdown();
  updateWaitCountdown();
  waitCountdownTimer=setInterval(updateWaitCountdown,1000);
}
function stopWaitCountdown(){
  if(waitCountdownTimer){ clearInterval(waitCountdownTimer); waitCountdownTimer=null; }
}
function showWaitPopup(opts){
  opts=opts||{};
  const mode=opts.mode||"success"; // success | locked
  const completedDay=opts.completedDay||state.currentDay;
  const nextDay=Math.min(60, completedDay+1);
  const icon=$("#waitIcon");
  const title=$("#waitTitle");
  const msg=$("#waitMessage");
  const box=$("#waitNextBox");
  const btn=$("#waitClose");
  const cd=$("#waitCountdown");
  if(cd) cd.style.color="#a99fff";
  if(mode==="success"){
    if(icon) icon.textContent="✅";
    if(title) title.textContent=`Day ${completedDay} submitted`;
    if(msg) msg.textContent="You can submit only once per day. The next challenge unlocks after 24 hours — keep your streak going.";
    if(btn) btn.textContent="Got it — see you in 24 hrs";
    if(box && nextDay<=60 && completedDay<60){
      const nc=typeof challenge==="function"?challenge(nextDay):(CHALLENGES.find(c=>c.day===nextDay)||{});
      box.style.display="block";
      box.innerHTML=`<div style="font-size:11px;color:var(--dim);font-weight:700;letter-spacing:.04em;margin-bottom:4px;">UP NEXT</div>
        <div style="font-weight:800;font-size:.95rem;">Day ${nextDay} · ${nc.title||"Next challenge"}</div>
        <div style="font-size:12px;color:var(--dim);margin-top:4px;">${nc.difficulty||""} · ${nc.time||""} · +50 XP</div>`;
    } else if(box){ box.style.display="none"; }
  } else {
    if(icon) icon.textContent="⏳";
    if(title) title.textContent="Come back in 24 hours";
    if(msg) msg.textContent="One submission per day. Watch the timer — your next challenge unlocks when it hits zero.";
    if(btn) btn.textContent="Okay";
    if(box) box.style.display="none";
  }
  startWaitCountdown();
  $("#waitOverlay")?.classList.add("show");
}
function hideWaitPopup(){
  stopWaitCountdown();
  $("#waitOverlay")?.classList.remove("show");
}

