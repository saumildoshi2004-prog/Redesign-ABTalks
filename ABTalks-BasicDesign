          if (!state.badges.find(b => b.name === name)) {
            state.badges.push({ name, icon, date: `Day ${state.currentDay}` });
            toast(`${name} badge earned!`, icon);
          }
        };
        if (state.submissions.length === 1) addBadge("First Commit", "🌟");
        if (state.profile.streak >= 7) addBadge("7 Day Streak", "🔥");
        if (state.submissions.length >= 10) addBadge("Consistent Coder", "💪");
        if (state.submissions.length >= 30) addBadge("Halfway Hero", "🏅");
        if (state.submissions.length >= 60) addBadge("Challenge Complete", "🏆");

        const idx = (state.currentDay - 1) % 7;
        if (state.weeklyActivity[idx] < 7) state.weeklyActivity[idx]++;

        const me = state.leaderboard.find(u => u.name === state.profile.name || u.isYou);
        if (me) { me.xp = state.profile.xp; me.streak = state.profile.streak; }

        // Certificate when Day 60 is done
        if (completedDay === 60 || state.submissions.length >= 60) {
          if (!state.profile.certificateId) {
            state.profile.certificateId = "ABT-" + Date.now().toString(36).toUpperCase() + "-" + Math.random().toString(36).slice(2,6).toUpperCase();
            state.profile.certificateIssuedAt = new Date().toISOString();
            toast("Certificate unlocked!","🏆");
          }
        }

        submitStatus = "success";
        save();
        confetti();
        toast("+50 XP earned");
        renderDay();
        // One submission per day — show 24h wait popup
        setTimeout(() => showWaitPopup({ mode:"success", completedDay }), 400);
      });

