<script>
const CHALLENGES=[
{day:1,title:"Hello World & Variables",difficulty:"Easy",time:"15 min",objectives:["Print Hello World","Declare variables","Basic data types"],instructions:"Write a program that prints 'Hello, World!' and declares variables of different types (string, number, boolean).",criteria:["Use console.log","Use let / const","Show typeof for each"],resources:["MDN — Variables"]},
{day:2,title:"Conditional Statements",difficulty:"Easy",time:"20 min",objectives:["If-else","Switch case"],instructions:"Write a program that checks if a number is even or odd using if-else. Also implement a simple grade checker with switch.",criteria:["Use if-else","Handle edge cases","Use switch"],resources:["MDN — Conditionals"]},
{day:3,title:"Loops & Iteration",difficulty:"Easy",time:"20 min",objectives:["For loop","While loop"],instructions:"Print numbers from 1 to 10 using both a for loop and a while loop. Then print only the even numbers.",criteria:["Use for loop","Use while loop","Filter even numbers"],resources:["MDN — Loops"]},
{day:4,title:"Functions Basics",difficulty:"Easy",time:"25 min",objectives:["Function declaration","Parameters","Return values"],instructions:"Create a function that adds two numbers and returns the result. Also write an arrow-function version of it.",criteria:["Use function keyword","Return a value","Arrow function"],resources:["MDN — Functions"]},
{day:5,title:"Arrays & Methods",difficulty:"Easy",time:"25 min",objectives:["Array creation","Push/pop","Map/Filter"],instructions:"Create an array of numbers and use map to double each value. Then filter values greater than 10.",criteria:["Use map","Use filter","Chain methods"],resources:["MDN — Arrays"]},
{day:6,title:"Objects & Properties",difficulty:"Easy",time:"25 min",objectives:["Object creation","Access properties","Methods"],instructions:"Create a student object with name, age, and a method to greet. Add a method that returns a summary string.",criteria:["Use object literal","Add a method","Use this keyword"],resources:["MDN — Objects"]},
{day:7,title:"String Manipulation",difficulty:"Easy",time:"20 min",objectives:["String methods","Template literals"],instructions:"Reverse a string and use template literals to build a formatted message from a few variables.",criteria:["Use split/reverse/join","Use template literals"],resources:["MDN — Strings"]},
{day:8,title:"Array Manipulation",difficulty:"Medium",time:"30 min",objectives:["Two pointers","In-place operations"],instructions:"Remove duplicates from a sorted array in-place, without allocating a new array. Return the new length.",criteria:["O(n) time","O(1) extra space"],resources:["LeetCode 26"]},
{day:9,title:"Binary Search",difficulty:"Medium",time:"30 min",objectives:["Binary search","Divide and conquer"],instructions:"Implement binary search to find an element in a sorted array. Return its index, or -1 if it isn't present.",criteria:["O(log n) time","Handle not-found case"],resources:["LeetCode 704"]},
{day:10,title:"Two Sum Problem",difficulty:"Medium",time:"30 min",objectives:["Hash map","Two-pointers"],instructions:"Given an array and a target, find the two numbers that add up to the target. Return their indices.",criteria:["O(n) time","Use a hash map"],resources:["LeetCode 1"]},
{day:11,title:"Palindrome Check",difficulty:"Easy",time:"20 min",objectives:["String reversal","Two pointers"],instructions:"Check whether a string is a palindrome, ignoring case, spaces and punctuation.",criteria:["Ignore case","Ignore spaces/punctuation"],resources:["LeetCode 125"]},
{day:12,title:"FizzBuzz",difficulty:"Easy",time:"15 min",objectives:["Conditional logic","Loop"],instructions:"Print numbers 1–100. For multiples of 3 print 'Fizz', for multiples of 5 print 'Buzz', and for multiples of both print 'FizzBuzz'.",criteria:["Use the modulo operator","Handle all four cases"],resources:["Classic interview problem"]},
{day:13,title:"Factorial Recursion",difficulty:"Medium",time:"25 min",objectives:["Recursion","Base case"],instructions:"Calculate a factorial using recursion. Handle 0! and negative input gracefully.",criteria:["Use recursion","Handle 0! correctly"],resources:["MDN — Recursion"]},
{day:14,title:"Valid Parentheses",difficulty:"Medium",time:"30 min",objectives:["Stack","String matching"],instructions:"Check whether a string of brackets — (), {}, [] — is validly matched and nested.",criteria:["Use a stack","Handle all three bracket types"],resources:["LeetCode 20"]},
{day:15,title:"Merge Sorted Arrays",difficulty:"Medium",time:"30 min",objectives:["Two pointers","In-place merge"],instructions:"Merge two sorted arrays into the first array so the result stays sorted, in-place.",criteria:["O(n+m) time","In-place merge"],resources:["LeetCode 88"]},
{day:16,title:"Linked List Basics",difficulty:"Medium",time:"35 min",objectives:["Node class","Traversal"],instructions:"Build a singly linked list from scratch and implement traversal plus insert-at-head.",criteria:["Use a Node class","Print all values in order"],resources:["MDN — Linked lists"]},
{day:17,title:"Stack Implementation",difficulty:"Medium",time:"30 min",objectives:["Stack operations","Array-based"],instructions:"Implement a stack with push, pop, peek and isEmpty methods, backed by an array.",criteria:["Array-backed","Handle empty stack"],resources:["Data structures reference"]},
{day:18,title:"Queue Implementation",difficulty:"Medium",time:"30 min",objectives:["Queue operations","Array-based"],instructions:"Implement a queue with enqueue, dequeue, front and isEmpty methods.",criteria:["Array-backed","Handle empty queue"],resources:["Data structures reference"]},
{day:19,title:"Tree Traversal",difficulty:"Hard",time:"40 min",objectives:["DFS","BFS"],instructions:"Implement in-order, pre-order and post-order traversal of a binary tree.",criteria:["Use recursion","Return/print all three orders"],resources:["Tree algorithms reference"]},
