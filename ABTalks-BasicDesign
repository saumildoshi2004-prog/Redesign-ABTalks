    function load() {
      try {
        const raw = localStorage.getItem(KEY);
        if (raw) {
          const p = JSON.parse(raw);
          return {
            ...DEFAULT,
            ...p,
            profile: { ...DEFAULT.profile, ...p.profile },
            leaderboard: DEFAULT.leaderboard.map(u => {
              if (u.name.includes("Mihir") && p.profile) {
                return { ...u, xp: p.profile.xp, streak: p.profile.streak };
              }
              return u;
            })
          };
        }
      } catch (_) {}
      return structuredClone(DEFAULT);
    }

