          ].map(q => `
            <div style="background:rgba(99,102,241,0.05);border-left:3px solid var(--primary);padding:13px 14px;border-radius:11px;margin:7px 0;">
              <p style="font-size:0.88rem;font-style:italic;color:#E2E8F0;line-height:1.48;">${q.t}</p>
              <span class="text-xs text-muted" style="margin-top:4px;display:block;font-weight:500;">${q.a}</span>
            </div>
          `).join("")}

          <div class="card">
            <h3 class="fw-7" style="font-size:0.98rem;">FAQ</h3>
            ${[
              { q:"Is it free?", a:"Yes — completely free for Indian college students." },
              { q:"What if I miss a day?", a:"Your streak resets, but you can always catch up on previous days." },
              { q:"How much time per day?", a:"Most tasks take 20–40 minutes. Day 60 is a mini project." }
            ].map((f,i,arr) => `
              <div style="border-bottom:${i<arr.length-1?'1px solid var(--border)':'none'};padding:12px 0;">
                <h4 class="fw-6" style="font-size:0.9rem;display:flex;gap:8px;align-items:center;">
                  <span class="badge">Q</span> ${f.q}
                </h4>
                <p class="text-muted text-sm" style="margin-top:2px;padding-left:28px;">${f.a}</p>
              </div>
            `).join("")}
          </div>

          <p class="text-center text-muted" style="font-size:0.68rem;letter-spacing:0.25px;padding:14px 0 4px;">
            © 2026 ABTalks · Made with ❤️ in India
          </p>
        </div>
      `;
      $("#joinBtn")?.addEventListener("click", () => { page = "dashboard"; render(); });
    }

    function renderDashboard() {
      const p = state.profile;
      const today = challenge(state.currentDay);
      const prog = overallProgress();
      const r = rank();
      const lp = levelProgress();
      const done = state.submissions.length;
      const commits = totalCommits();
      const dayNames = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];

      let heatmapHTML = "";
      heatmapHTML += `<div class="heatmap-day-label"></div>`;
      dayNames.forEach(d => {
        heatmapHTML += `<div class="heatmap-day-label" style="text-align:center;font-size:9.5px;">${d[0]}</div>`;
      });

      state.weeklyActivity.forEach((week, wi) => {
        heatmapHTML += `<div class="heatmap-day-label">W${wi + 1}</div>`;
        week.forEach((v, di) => {
          const lvl = activityLevel(v);
          const tip = v === 0 ? "No activity" : `${v} commit${v > 1 ? "s" : ""} · ${dayNames[di]}`;
          heatmapHTML += `<div class="heatmap-cell ${lvl} has-tip" data-tip="${tip}" title="${tip}"></div>`;
        });
      });

      app.innerHTML = `
        <div class="page">
          <div class="flex-between" style="margin-bottom:11px;">
            <div class="flex gap-2" style="align-items:center;">
              <span style="font-size:2.1rem;line-height:1;">${p.avatar}</span>
              <div>
                <h2 class="fw-7" style="font-size:1.28rem;letter-spacing:-0.25px;">${p.name}</h2>
                <span class="text-muted text-sm">ID ${p.id} · Level ${p.level} · ${p.xp.toLocaleString()} XP</span>
              </div>
            </div>
            <span class="streak"><i class="fas fa-fire"></i> ${p.streak}</span>
          </div>

          <div style="margin-bottom:12px;">
            <div class="flex-between text-xs text-muted">
              <span>Level ${p.level}</span>
              <span>${p.xp % 500} / 500 XP</span>
            </div>
            <div class="progress" style="height:5px;margin-top:4px;">
              <div class="progress-fill" style="width:${lp}%;"></div>
            </div>
          </div>

          <div class="grid-2" style="margin-bottom:2px;">
            <div class="card accent" style="margin-bottom:0;">
              <div class="flex-between">
                <span class="badge">Day ${today.day}</span>
                <span class="text-muted text-xs"><i class="far fa-clock"></i> ${today.time}</span>
              </div>
              <h3 class="fw-7" style="margin:7px 0 2px;font-size:1.04rem;">${today.title}</h3>
              <p class="text-muted text-sm">${today.difficulty} · ${today.objectives.slice(0,2).join(" · ")}</p>
              <button class="btn btn-primary btn-sm" id="goDay" style="margin-top:11px;">
                <i class="fas fa-arrow-right"></i> Continue
              </button>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;">
              <div class="card" style="padding:12px;margin-bottom:0;">
                <div class="flex-between text-sm">
                  <span>Progress</span>
                  <span class="fw-7">${Math.round(prog)}%</span>
                </div>
                <div class="progress" style="margin-top:5px;"><div class="progress-fill" style="width:${prog}%;"></div></div>
                <div class="text-xs text-muted" style="margin-top:3px;">${done} of 60 done</div>
              </div>
              <div class="card" style="padding:12px;margin-bottom:0;flex:1;display:flex;flex-direction:column;justify-content:center;text-align:center;">
                <span class="fw-8" style="font-size:1.35rem;color:var(--warning);">#${r}</span>
                <span class="text-xs text-muted">rank</span>
              </div>
            </div>
          </div>

          <div class="stat-row">
            <div class="stat" style="background:rgba(6,182,212,0.04);">
              <i class="fas fa-medal" style="color:var(--accent);"></i>
              <div class="val">${state.badges.length}</div>
              <div class="lbl">badges</div>
            </div>
            <div class="stat" style="background:rgba(34,197,94,0.04);">
              <i class="fas fa-check-circle" style="color:var(--success);"></i>
              <div class="val">${done}</div>
              <div class="lbl">submitted</div>
            </div>
            <div class="stat" style="background:rgba(139,92,246,0.04);">
              <i class="fas fa-chart-line" style="color:var(--secondary);"></i>
              <div class="val">${p.careerReadiness}%</div>
              <div class="lbl">readiness</div>
            </div>
          </div>

          <div class="card activity-section">
            <div class="activity-header">
              <h4>
                <i class="fas fa-chart-area" style="color:var(--primary);"></i>
                Weekly activity
              </h4>
              <span class="activity-summary"><strong>${commits}</strong> commits this month</span>
            </div>
            <div class="heatmap-wrap">
              <div class="heatmap">
                ${heatmapHTML}
              </div>
              <div class="heatmap-legend">
                <span>Less</span>
                <div class="legend-cell l0"></div>
                <div class="legend-cell l1"></div>
                <div class="legend-cell l2"></div>
                <div class="legend-cell l3"></div>
                <div class="legend-cell l4"></div>
                <div class="legend-cell l5"></div>
                <span>More</span>
              </div>
            </div>
          </div>

          <div class="card">
            <h4 class="fw-6 text-sm" style="display:flex;gap:8px;align-items:center;">
              <i class="fas fa-award" style="color:var(--secondary);"></i> Achievements
            </h4>
            <div class="scroll-x">
              ${state.badges.length === 0
                ? `<div class="empty" style="padding:12px;width:100%;font-size:0.84rem;"><i class="fas fa-trophy"></i><p>No badges yet</p></div>`
                : state.badges.map(b => `
                    <div style="background:rgba(255,255,255,0.025);padding:7px 13px;border-radius:40px;display:flex;align-items:center;gap:7px;border:1px solid var(--border);">
                      <span style="font-size:1.2rem;">${b.icon}</span>
                      <div>
                        <div class="fw-6" style="font-size:0.74rem;">${b.name}</div>
                        <div class="text-muted" style="font-size:0.56rem;">${b.date}</div>
                      </div>
                    </div>
                  `).join("")
              }
            </div>
          </div>

          <div class="quote">
            <span style="color:var(--primary);margin-right:5px;">✨</span>“${quote()}”
          </div>
        </div>
      `;
      $("#goDay")?.addEventListener("click", () => { page = "day"; render(); });
    }

    function renderDay() {
      const c = challenge(state.currentDay);
      const done = submitted(state.currentDay);
      const sub = submission(state.currentDay);

      const start = Math.max(1, state.currentDay - 8);
      const end = Math.min(60, state.currentDay + 8);
      let dots = "";
      for (let d = start; d <= end; d++) {
        let cls = "day-dot";
        if (d === state.currentDay) cls += " current";
        else if (submitted(d)) cls += " done";
        dots += `<button type="button" class="${cls}" data-day="${d}" aria-label="Go to day ${d}">${d}</button>`;
      }

      app.innerHTML = `
        <div class="page">
          <div class="day-strip" id="dayStrip">${dots}</div>

          <div class="flex-between" style="margin-bottom:2px;">
            <span class="fw-8" style="font-size:2.2rem;background:linear-gradient(135deg,#6366F1,#8B5CF6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-0.9px;">Day ${c.day}</span>
            <span class="badge ${diffClass(c.difficulty)}">${c.difficulty}</span>
          </div>
          <h2 class="fw-7" style="font-size:1.15rem;margin-bottom:3px;">${c.title}</h2>
          <p class="text-muted text-sm" style="margin-bottom:11px;">
            <i class="far fa-clock"></i> ${c.time} · ${c.objectives.join(" · ")}
          </p>

          <div class="card">
            <h4 class="fw-6 text-sm" style="display:flex;gap:7px;align-items:center;">
              <i class="fas fa-book-open" style="color:var(--primary);"></i> Instructions
            </h4>
            <p style="color:#E2E8F0;font-size:0.9rem;margin:7px 0;line-height:1.52;">${c.instructions}</p>
            <div class="chips">
              ${c.criteria.map(x => `<span class="chip on">${x}</span>`).join("")}
            </div>
            <div style="margin-top:11px;">
              <span class="text-xs text-muted fw-6">Resources</span>
              ${c.resources.map(r => `
                <div style="color:var(--primary-light);font-size:0.82rem;margin-top:2px;">
                  <i class="fas fa-book" style="font-size:0.62rem;opacity:0.6;"></i> ${r}
                </div>
              `).join("")}
            </div>
            ${done ? `<div class="badge success" style="margin-top:11px;"><i class="fas fa-check-circle"></i> Submitted</div>` : ""}
          </div>

          <div class="card">
            <h4 class="fw-6 text-sm" style="display:flex;gap:7px;align-items:center;">
              <i class="fas fa-paper-plane" style="color:var(--accent);"></i> Submit your work
            </h4>
            <div class="field" id="ghField">
              <i class="fab fa-github"></i>
              <input type="url" id="githubInput" placeholder="GitHub commit or repo URL" value="${sub?.github || ""}" ${done ? "readonly" : ""} autocomplete="off" />
            </div>
            <div class="field-hint" id="ghHint">Include github.com in the URL</div>
            <div class="field" id="liField">
              <i class="fab fa-linkedin"></i>
              <input type="url" id="linkedinInput" placeholder="LinkedIn post URL" value="${sub?.linkedin || ""}" ${done ? "readonly" : ""} autocomplete="off" />
            </div>
            <div class="field-hint" id="liHint">Include linkedin.com in the URL</div>
            <button class="btn btn-primary" id="submitBtn" style="margin-top:5px;" ${done ? "disabled" : ""}>
              <i class="fas ${done ? "fa-check-circle" : "fa-paper-plane"}"></i>
              ${done ? "Submitted" : "Submit & earn +50 XP"}
            </button>
            ${submitStatus === "success" ? `
              <div class="success-banner">
                <i class="fas fa-check-circle" style="color:var(--success);font-size:1.15rem;"></i>
                <div><span class="fw-7" style="color:var(--success);">+50 XP</span> <span class="text-muted text-sm">· Streak updated</span></div>
              </div>
            ` : ""}
            ${submitStatus === "error" ? `
              <div class="error-banner">
                <i class="fas fa-exclamation-circle"></i> Please enter valid GitHub and LinkedIn URLs.
              </div>
            ` : ""}
          </div>

          <div class="flex gap-1" style="margin:5px 0 7px;">
            <button class="btn btn-secondary" id="prevDay" style="flex:1;" ${state.currentDay <= 1 ? "disabled" : ""}>
              <i class="fas fa-arrow-left"></i> Prev
            </button>
            <button class="btn btn-secondary" id="nextDay" style="flex:1;" ${state.currentDay >= 60 ? "disabled" : ""}>
              Next <i class="fas fa-arrow-right"></i>
            </button>
          </div>

          <div class="flex-center gap-2 text-muted text-sm" style="padding:3px 0 6px;">
            <span><i class="fas fa-star" style="color:var(--warning);"></i> +50 XP</span>
            <span><i class="fas fa-fire" style="color:var(--warning);"></i> Streak</span>
            <span><i class="fas fa-medal" style="color:var(--secondary);"></i> Badges</span>
          </div>
        </div>
      `;

      requestAnimationFrame(() => {
        const strip = $("#dayStrip");
        const cur = strip?.querySelector(".day-dot.current");
        if (cur && strip) {
          const left = cur.offsetLeft - strip.clientWidth / 2 + cur.clientWidth / 2;
          strip.scrollTo({ left, behavior: "smooth" });
        }
      });

      $$(".day-dot").forEach(btn => {
        btn.addEventListener("click", () => {
          state.currentDay = +btn.dataset.day;
          submitStatus = null;
          save();
          renderDay();
        });
      });

      const ghIn = $("#githubInput");
      const liIn = $("#linkedinInput");
      ghIn?.addEventListener("input", () => {
        $("#ghField")?.classList.remove("error");
        $("#ghHint")?.classList.remove("show");
      });
      liIn?.addEventListener("input", () => {
        $("#liField")?.classList.remove("error");
        $("#liHint")?.classList.remove("show");
      });

      $("#submitBtn")?.addEventListener("click", () => {
        if (submitted(state.currentDay)) return;

        const github = ghIn.value.trim();
        const linkedin = liIn.value.trim();
        const okGh = github && (github.includes("github.com") || github.includes("gist.github.com"));
        const okLi = linkedin && linkedin.includes("linkedin.com");

        if (!okGh || !okLi) {
          if (!okGh) { $("#ghField")?.classList.add("error"); $("#ghHint")?.classList.add("show"); }
          if (!okLi) { $("#liField")?.classList.add("error"); $("#liHint")?.classList.add("show"); }
          submitStatus = "error";
          renderDay();
          return;
        }

        state.submissions.push({ day: state.currentDay, github, linkedin });
        state.profile.xp += 50;

        const newLevel = Math.floor(state.profile.xp / 500) + 1;
        if (newLevel > state.profile.level) {
          state.profile.level = newLevel;
          toast(`Level ${newLevel} unlocked!`, "🎉");
        }

        if (state.currentDay === state.profile.streak + 1) {
          state.profile.streak++;
        }

        state.profile.careerReadiness = Math.min(98, Math.round(38 + (state.submissions.length / 60) * 60));

        const addBadge = (name, icon) => {
          if (!state.badges.find(b => b.name === name)) {
            state.badges.push({ name, icon, date: `Day ${state.currentDay}` });
            toast(`${name} badge earned!`, icon);
          }
        };
        if (state.submissions.length === 1) addBadge("First Commit", "🌟");
        if (state.profile.streak >= 7) addBadge("7 Day Streak", "🔥");
        if (state.submissions.length >= 10) addBadge("Consistent Coder", "💪");
        if (state.submissions.length >= 30) addBadge("Halfway Hero", "🏅");
        if (state.submissions.length >= 60) addBadge("Challenge Complete", "🏆");

        const lastWeek = state.weeklyActivity[state.weeklyActivity.length - 1];
        const dayIdx = (state.currentDay - 1) % 7;
        if (lastWeek[dayIdx] < 7) lastWeek[dayIdx]++;

        const me = state.leaderboard.find(u => u.name.includes("Mihir"));
        if (me) { me.xp = state.profile.xp; me.streak = state.profile.streak; }

        submitStatus = "success";
        save();
        confetti();
        toast("+50 XP earned");

        setTimeout(() => {
          submitStatus = null;
          renderDay();
        }, 2500);

        renderDay();
      });

      $("#prevDay")?.addEventListener("click", () => {
        if (state.currentDay > 1) {
          state.currentDay--;
          submitStatus = null;
          save();
          renderDay();
        }
      });
      $("#nextDay")?.addEventListener("click", () => {
        if (state.currentDay < 60) {
          state.currentDay++;
          submitStatus = null;
          save();
          renderDay();
        }
      });
    }

    function renderLeaderboard() {
      const sorted = [...state.leaderboard].sort((a, b) => b.xp - a.xp);
      const myRank = rank();

      app.innerHTML = `
        <div class="page">
          <div style="margin-bottom:13px;">
            <h2 class="fw-8" style="font-size:1.35rem;letter-spacing:-0.35px;">Leaderboard</h2>
            <p class="text-muted text-sm">Top performers this cohort</p>
          </div>

          <div class="card accent" style="margin-bottom:11px;">
            <div class="flex-between">
              <div>
                <div class="text-xs text-muted">Your rank</div>
                <div class="fw-8" style="font-size:1.45rem;color:var(--warning);">#${myRank}</div>
              </div>
              <div style="text-align:right;">
                <div class="text-xs text-muted">Your XP</div>
                <div class="fw-7" style="font-size:1.15rem;">${state.profile.xp.toLocaleString()}</div>
              </div>
            </div>
          </div>

          <div class="card" style="padding:3px 0;">
            ${sorted.map((u, i) => {
              const isMe = u.name.includes("Mihir") || u.name === state.profile.name;
              const medal = i === 0 ? "🥇" : i === 1 ? "🥈" : i === 2 ? "🥉" : "";
              return `
                <div style="display:flex;align-items:center;gap:11px;padding:10px 13px;${i < sorted.length - 1 ? "border-bottom:1px solid var(--border);" : ""}${isMe ? "background:rgba(99,102,241,0.06);" : ""}">
                  <div style="width:24px;text-align:center;font-weight:700;font-size:0.9rem;color:${i < 3 ? "var(--warning)" : "var(--muted)"};">
                    ${medal || (i + 1)}
                  </div>
                  <span style="font-size:1.3rem;">${u.avatar}</span>
                  <div style="flex:1;min-width:0;">
                    <div class="fw-6 truncate" style="font-size:0.88rem;${isMe ? "color:var(--primary-light);" : ""}">${u.name}${isMe ? " (you)" : ""}</div>
                    <div class="text-xs text-muted">${u.streak || 0} day streak</div>
                  </div>
                  <div class="fw-7" style="font-size:0.9rem;">${u.xp.toLocaleString()} <span class="text-xs text-muted" style="font-weight:500;">XP</span></div>
                </div>
              `;
            }).join("")}
          </div>

          <p class="text-center text-muted text-xs" style="margin-top:9px;">
            Rankings update as you submit. Keep shipping.
          </p>
        </div>
      `;
    }

    $$(".nav-item").forEach(el => {
      el.addEventListener("click", () => {
        const p = el.dataset.page;
        if (["landing","dashboard","day","leaderboard"].includes(p)) {
          page = p;
          submitStatus = null;
          render();
        }
      });
    });

    render();
  </script>
</body>
</html>
