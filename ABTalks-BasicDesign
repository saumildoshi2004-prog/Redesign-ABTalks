<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#0B1120" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="description" content="ABTalks · 60-day coding challenge. Build real skills, ship daily, stay consistent." />
  <title>ABTalks · 60-day coding challenge</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    /* ========== DESIGN SYSTEM ========== */
    :root {
      --primary: #6366F1;
      --primary-light: #818CF8;
      --primary-dark: #4F46E5;
      --secondary: #8B5CF6;
      --accent: #06B6D4;
      --success: #22C55E;
      --warning: #F59E0B;
      --danger: #EF4444;
      --bg: #0B1120;
      --surface: #111827;
      --card: #1E293B;
      --text: #F8FAFC;
      --text-secondary: #CBD5E1;
      --muted: #94A3B8;
      --radius: 16px;
      --radius-lg: 22px;
      --radius-xl: 28px;
      --shadow: 0 8px 30px -8px rgba(0,0,0,0.55);
      --shadow-lg: 0 20px 50px -12px rgba(0,0,0,0.7);
      --glass: rgba(17, 24, 39, 0.78);
      --border: rgba(255,255,255,0.06);
      --border-strong: rgba(255,255,255,0.1);
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --nav-h: 72px;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    /* ========== RESET ========== */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      height: 100%;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.55;
      min-height: 100%;
      min-height: 100dvh;
      padding-bottom: calc(var(--nav-h) + var(--safe-bottom) + 8px);
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }
    a { text-decoration: none; color: inherit; }
    button, input, textarea {
      font: inherit;
      border: none;
      outline: none;
      background: none;
      color: inherit;
    }
    button { cursor: pointer; }
    img, svg { display: block; max-width: 100%; }
    ::selection { background: rgba(99,102,241,0.35); color: #fff; }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(99,102,241,0.5); border-radius: 20px; }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* ========== LAYOUT ========== */
    .container {
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
      padding: 16px 16px 12px;
    }

    /* ========== BOTTOM NAV ========== */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: calc(var(--nav-h) + var(--safe-bottom));
      padding-bottom: var(--safe-bottom);
      background: rgba(11, 17, 32, 0.88);
      backdrop-filter: blur(24px) saturate(1.6);
      -webkit-backdrop-filter: blur(24px) saturate(1.6);
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 100;
      box-shadow: 0 -8px 32px rgba(0,0,0,0.4);
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      min-width: 64px;
      height: 56px;
      padding: 6px 10px;
      border-radius: 14px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.2px;
      color: var(--muted);
      transition: color 0.22s var(--ease), transform 0.18s var(--ease);
      position: relative;
      user-select: none;
      -webkit-user-select: none;
    }
    .nav-item i {
      font-size: 20px;
      transition: transform 0.22s var(--ease), color 0.22s var(--ease), filter 0.22s;
    }
    .nav-item.active { color: var(--primary-light); }
    .nav-item.active i {
      color: var(--primary);
      transform: translateY(-1px) scale(1.05);
      filter: drop-shadow(0 0 8px rgba(99,102,241,0.5));
    }
    .nav-item:active { transform: scale(0.92); }
    .nav-badge {
      position: absolute;
      top: 4px;
      right: 8px;
      min-width: 17px;
      height: 17px;
      padding: 0 5px;
      background: linear-gradient(135deg, #EF4444, #F97316);
      color: #fff;
      font-size: 9px;
      font-weight: 700;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(239,68,68,0.45);
      line-height: 1;
    }

    /* ========== CARDS ========== */
    .card {
      background: var(--glass);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
      box-shadow: var(--shadow);
      margin-bottom: 12px;
      transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
    }
    .card:hover { border-color: var(--border-strong); }
    .card.accent { border-left: 3px solid var(--primary); }
    .card.flat {
      background: rgba(255,255,255,0.025);
      box-shadow: none;
    }

    /* ========== BADGES ========== */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 11px;
      border-radius: 40px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.2px;
      background: rgba(99,102,241,0.14);
      color: var(--primary-light);
      border: 1px solid rgba(99,102,241,0.18);
      white-space: nowrap;
    }
    .badge.success { background: rgba(34,197,94,0.12); color: var(--success); border-color: rgba(34,197,94,0.2); }
    .badge.warning { background: rgba(245,158,11,0.12); color: var(--warning); border-color: rgba(245,158,11,0.2); }
    .badge.danger  { background: rgba(239,68,68,0.1); color: var(--danger); border-color: rgba(239,68,68,0.18); }
    .badge.accent  { background: rgba(6,182,212,0.1); color: var(--accent); border-color: rgba(6,182,212,0.18); }

    /* ========== BUTTONS ========== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      width: 100%;
      padding: 14px 20px;
      border-radius: 60px;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.15px;
      transition: transform 0.2s var(--ease), box-shadow 0.25s, opacity 0.2s, background 0.2s;
      position: relative;
      overflow: hidden;
      user-select: none;
    }
    .btn:active:not(:disabled) { transform: scale(0.97); }
    .btn:disabled { opacity: 0.42; pointer-events: none; }

    .btn-primary {
      background: linear-gradient(135deg, #6366F1 0%, #7C3AED 100%);
      color: #fff;
      box-shadow: 0 6px 20px rgba(99,102,241,0.32);
    }
    .btn-primary::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, transparent 30%, rgba(255,255,255,0.12), transparent 70%);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .btn-primary:hover::after { opacity: 1; }
    .btn-primary:active { box-shadow: 0 3px 12px rgba(99,102,241,0.25); }

    .btn-secondary {
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      color: var(--text);
    }
    .btn-secondary:hover {
      background: rgba(255,255,255,0.07);
      border-color: var(--border-strong);
    }

    .btn-ghost {
      background: transparent;
      color: var(--muted);
      padding: 10px 14px;
      width: auto;
    }
    .btn-ghost:hover { color: var(--text); }

    .btn-sm { padding: 10px 16px; font-size: 13px; }

    /* ========== PROGRESS ========== */
    .progress {
      height: 6px;
      background: #1E293B;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.3);
    }
    .progress-fill {
      height: 100%;
      border-radius: 20px;
      background: linear-gradient(90deg, #6366F1, #06B6D4);
      transition: width 0.85s var(--ease-out);
      position: relative;
    }
    .progress-fill::after {
      content: '';
      position: absolute;
      right: 0; top: 0;
      width: 20px; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25));
      border-radius: 20px;
    }

    /* ========== STREAK ========== */
    .streak {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 40px;
      font-size: 0.82rem;
      font-weight: 700;
      background: rgba(245,158,11,0.1);
      color: var(--warning);
      border: 1px solid rgba(245,158,11,0.18);
    }
    .streak i { animation: fire 1.5s ease-in-out infinite; }
    @keyframes fire {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }

    /* ========== INPUTS ========== */
    .field {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #1E293B;
      border: 1px solid var(--border);
      border-radius: 60px;
      padding: 3px 16px;
      margin: 8px 0;
      transition: border-color 0.22s, box-shadow 0.22s;
    }
    .field:focus-within {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(99,102,241,0.16);
    }
    .field.error {
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(239,68,68,0.12);
    }
    .field i {
      color: var(--muted);
      font-size: 1.05rem;
      width: 20px;
      text-align: center;
      flex-shrink: 0;
    }
    .field input {
      flex: 1;
      padding: 12px 0;
      background: transparent;
      color: var(--text);
      font-size: 14px;
      font-weight: 500;
      min-width: 0;
    }
    .field input::placeholder { color: var(--muted); font-weight: 400; }
    .field input:read-only { opacity: 0.7; }
    .field-hint {
      font-size: 12px;
      color: var(--danger);
      margin: -4px 0 6px 16px;
      opacity: 0;
      transform: translateY(-4px);
      transition: opacity 0.2s, transform 0.2s;
    }
    .field-hint.show { opacity: 1; transform: translateY(0); }

    /* ========== CHIPS ========== */
    .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 2px; }
    .chip {
      padding: 4px 12px;
      border-radius: 40px;
      font-size: 12px;
      font-weight: 500;
      background: rgba(255,255,255,0.04);
      color: var(--muted);
      border: 1px solid transparent;
    }
    .chip.on {
      background: rgba(99,102,241,0.1);
      color: var(--text-secondary);
      border-color: rgba(99,102,241,0.3);
    }

    /* ========== DAY SELECTOR ========== */
    .day-strip {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding: 2px 2px 14px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }
    .day-strip::-webkit-scrollbar { display: none; }
    .day-dot {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      background: #1E293B;
      color: var(--muted);
      border: 1.5px solid transparent;
      scroll-snap-align: center;
      transition: all 0.22s var(--ease);
      cursor: pointer;
    }
    .day-dot.current {
      background: linear-gradient(135deg, #6366F1, #8B5CF6);
      color: #fff;
      box-shadow: 0 4px 14px rgba(99,102,241,0.4);
      transform: scale(1.08);
    }
    .day-dot.done {
      background: rgba(34,197,94,0.14);
      color: var(--success);
      border-color: rgba(34,197,94,0.28);
    }
    .day-dot:hover:not(.current) {
      border-color: var(--primary);
      color: var(--text);
    }

    /* ========== ACTIVITY ========== */
    .activity-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 5px;
      margin-top: 10px;
    }
    .activity-label {
      text-align: center;
      font-size: 10px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.3px;
    }
    .activity-cell {
      aspect-ratio: 1;
      border-radius: 5px;
      background: #1E293B;
      transition: transform 0.15s, border-color 0.15s;
      border: 1px solid transparent;
    }
    .activity-cell.l1 { background: #1E3A5F; }
    .activity-cell.l2 { background: #2D4B7A; }
    .activity-cell.l3 { background: #4F7EB3; }
    .activity-cell.l4 { background: #7BA9E0; }
    .activity-cell:hover {
      transform: scale(1.1);
      border-color: var(--primary);
      z-index: 1;
    }

    /* ========== SCROLL X ========== */
    .scroll-x {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 4px 0 8px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .scroll-x::-webkit-scrollbar { display: none; }
    .scroll-x > * { flex: 0 0 auto; scroll-snap-align: start; }

    /* ========== TOAST ========== */
    .toast-wrap {
      position: fixed;
      top: max(16px, env(safe-area-inset-top));
      left: 50%;
      transform: translateX(-50%) translateY(-120%);
      z-index: 300;
      transition: transform 0.4s var(--ease-out);
      pointer-events: none;
    }
    .toast-wrap.show { transform: translateX(-50%) translateY(0); }
    .toast {
      background: rgba(17,24,39,0.94);
      border: 1px solid var(--border-strong);
      padding: 11px 18px;
      border-radius: 40px;
      font-size: 13px;
      font-weight: 500;
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(16px);
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ========== CONFETTI ========== */
    .confetti-layer {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 250;
      overflow: hidden;
    }

    /* ========== PAGE TRANSITION ========== */
    .page {
      animation: pageIn 0.4s var(--ease-out) forwards;
    }
    @keyframes pageIn {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ========== MISC ========== */
    .flex { display: flex; }
    .flex-between { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
    .flex-center { display: flex; align-items: center; justify-content: center; }
    .gap-1 { gap: 8px; }
    .gap-2 { gap: 12px; }
    .text-muted { color: var(--muted); }
    .text-sm { font-size: 0.85rem; }
    .text-xs { font-size: 0.75rem; }
    .fw-6 { font-weight: 600; }
    .fw-7 { font-weight: 700; }
    .fw-8 { font-weight: 800; }
    .mt-1 { margin-top: 8px; }
    .mb-1 { margin-bottom: 8px; }
    .truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .stat-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
      margin: 12px 0 4px;
    }
    .stat {
      text-align: center;
      padding: 12px 6px;
      border-radius: var(--radius);
      background: rgba(255,255,255,0.025);
      border: 1px solid var(--border);
    }
    .stat i { font-size: 1.1rem; margin-bottom: 2px; }
    .stat .val { font-weight: 700; font-size: 0.95rem; }
    .stat .lbl { font-size: 0.62rem; color: var(--muted); }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .empty {
      text-align: center;
      padding: 32px 12px;
      color: var(--muted);
    }
    .empty i { font-size: 2.6rem; opacity: 0.2; margin-bottom: 8px; }

    .quote {
      background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(139,92,246,0.04));
      border: 1px solid rgba(99,102,241,0.12);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      font-style: italic;
      font-size: 0.92rem;
      color: #E2E8F0;
      line-height: 1.55;
    }

    .success-banner {
      margin-top: 12px;
      padding: 12px 14px;
      background: rgba(34,197,94,0.09);
      border-radius: 14px;
      border-left: 3px solid var(--success);
      display: flex;
      align-items: center;
      gap: 10px;
      animation: slideUp 0.4s var(--ease-out);
    }
    .error-banner {
      margin-top: 12px;
      padding: 12px 14px;
      background: rgba(239,68,68,0.09);
      border-radius: 14px;
      border-left: 3px solid var(--danger);
      color: var(--danger);
      font-size: 0.88rem;
      animation: slideUp 0.4s var(--ease-out);
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
    @keyframes confettiFall {
      0% { transform: translateY(0) rotate(0) scale(1); opacity: 1; }
      100% { transform: translateY(110vh) rotate(720deg) scale(0.2); opacity: 0; }
    }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(99,102,241,0.28); }
      50% { box-shadow: 0 0 0 10px rgba(99,102,241,0); }
    }
    .pulse { animation: pulseGlow 2.5s ease-in-out infinite; }

    /* ========== RESPONSIVE ========== */
    @media (min-width: 640px) {
      .container { max-width: 540px; padding: 24px 24px 16px; }
      .bottom-nav {
        max-width: 540px;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 24px 24px 0 0;
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
      }
      .grid-2 { grid-template-columns: 1fr 1fr; }
    }
    @media (min-width: 900px) {
      .container { max-width: 680px; padding: 28px 32px 20px; }
      .bottom-nav { max-width: 600px; }
    }
  </style>
</head>
<body>
  <div class="toast-wrap" id="toastWrap" aria-live="polite">
    <div class="toast" id="toast"></div>
  </div>

  <nav class="bottom-nav" id="bottomNav" role="navigation" aria-label="Main navigation">
    <button class="nav-item active" data-page="dashboard" aria-label="Home" aria-current="page">
      <i class="fas fa-home"></i><span>Home</span>
    </button>
    <button class="nav-item" data-page="day" aria-label="Today's challenge">
      <i class="fas fa-code"></i><span>Today</span>
      <span class="nav-badge" id="dayBadge">8</span>
    </button>
    <button class="nav-item" data-page="leaderboard" aria-label="Leaderboard">
      <i class="fas fa-trophy"></i><span>Rank</span>
    </button>
    <button class="nav-item" data-page="landing" aria-label="About and join">
      <i class="fas fa-rocket"></i><span>Join</span>
    </button>
  </nav>

  <main id="app" class="container" role="main"></main>

  <script>
    // ============================================================
    //  DATA
    // ============================================================
    const CHALLENGES = [
      { day:1, title:"Hello World & Variables", difficulty:"Easy", time:"15 min", objectives:["Print Hello World","Declare variables","Basic data types"], instructions:"Write a program that prints 'Hello, World!' and declares variables of different types (string, number, boolean).", criteria:["Use console.log","Use let / const","Show typeof"], resources:["MDN Variables"] },
      { day:2, title:"Conditional Statements", difficulty:"Easy", time:"20 min", objectives:["If-else","Switch case"], instructions:"Write a program that checks if a number is even or odd using if-else. Also implement a simple grade checker with switch.", criteria:["Use if-else","Handle edge cases","Use switch"], resources:["MDN Conditionals"] },
      { day:3, title:"Loops & Iteration", difficulty:"Easy", time:"20 min", objectives:["For loop","While loop"], instructions:"Print numbers from 1 to 10 using both for and while loops. Then print only even numbers.", criteria:["Use for loop","Use while loop","Filter even"], resources:["MDN Loops"] },
