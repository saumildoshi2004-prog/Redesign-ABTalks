        const s = 4 + Math.random() * 8;
        p.style.cssText = `
          position:absolute;width:${s}px;height:${s}px;
          background:${colors[Math.floor(Math.random()*colors.length)]};
          border-radius:${Math.random()>0.5?"50%":"2px"};
          left:${Math.random()*100}%;top:-10%;
