<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>ABTalks · 60‑day coding challenge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #0B1120;
            color: #F1F5F9;
            line-height: 1.6;
            min-height: 100vh;
            padding: 0 0 90px 0;
            -webkit-tap-highlight-color: transparent;
        }
        a {
            text-decoration: none;
            color: inherit;
        }
        button,
        input,
        textarea {
            font: inherit;
            border: none;
            outline: none;
            background: none;
            color: inherit;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1E293B;
        }
        ::-webkit-scrollbar-thumb {
            background: #6366F1;
            border-radius: 20px;
        }

        /* ----- DESIGN TOKENS ----- */
        :root {
            --primary: #6366F1;
            --primary-light: #818CF8;
            --secondary: #8B5CF6;
            --accent: #06B6D4;
            --success: #22C55E;
            --warning: #F59E0B;
            --danger: #EF4444;
            --bg: #0B1120;
            --surface: #111827;
            --card: #1E293B;
            --text: #F1F5F9;
            --muted: #94A3B8;
            --radius: 24px;
            --shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.7);
            --glass: rgba(17, 24, 39, 0.78);
            --border-subtle: rgba(255, 255, 255, 0.06);
        }

        /* ----- LAYOUT ----- */
        .container {
            max-width: 480px;
            margin: 0 auto;
            padding: 16px 18px;
        }

        /* ----- BOTTOM NAV ----- */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(11, 17, 32, 0.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 1px solid var(--border-subtle);
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 8px 0 env(safe-area-inset-bottom, 10px);
            z-index: 100;
            box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.5);
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 10px;
            font-weight: 600;
            color: var(--muted);
            transition: 0.25s ease;
            padding: 6px 14px;
            border-radius: 40px;
            gap: 2px;
            cursor: pointer;
            letter-spacing: 0.3px;
            position: relative;
            min-width: 60px;
        }
        .nav-item i {
            font-size: 22px;
            margin-bottom: 2px;
            transition: 0.25s;
        }
        .nav-item.active {
            color: var(--primary-light);
        }
        .nav-item.active i {
            color: var(--primary);
            text-shadow: 0 0 20px rgba(99, 102, 241, 0.5);
        }
        .nav-item .nav-badge {
            position: absolute;
            top: -2px;
            right: 2px;
            background: var(--danger);
            color: white;
            font-size: 8px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 30px;
            line-height: 1.2;
            min-width: 18px;
            text-align: center;
        }

        /* ----- CARDS ----- */
        .glass-card {
            background: var(--glass);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius);
            padding: 20px 18px;
            box-shadow: var(--shadow);
            margin-bottom: 18px;
            transition: transform 0.2s cubic-bezier(0.2, 0.9, 0.4, 1), box-shadow 0.3s;
        }
        .glass-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.8);
        }
        .glass-card.dark {
            background: rgba(11, 17, 32, 0.6);
            border-color: rgba(255, 255, 255, 0.03);
        }

        .badge {
            display: inline-block;
            background: rgba(99, 102, 241, 0.18);
            color: var(--primary-light);
            font-weight: 600;
            font-size: 11px;
            padding: 4px 14px;
            border-radius: 40px;
            letter-spacing: 0.4px;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(99, 102, 241, 0.15);
        }
        .badge.success {
            background: rgba(34, 197, 94, 0.15);
            color: var(--success);
            border-color: rgba(34, 197, 94, 0.2);
        }
        .badge.warning {
            background: rgba(245, 158, 11, 0.15);
            color: var(--warning);
            border-color: rgba(245, 158, 11, 0.2);
        }
        .badge.accent {
            background: rgba(6, 182, 212, 0.12);
            color: var(--accent);
            border-color: rgba(6, 182, 212, 0.2);
        }
        .badge.danger {
            background: rgba(239, 68, 68, 0.12);
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.2);
        }

        /* ----- BUTTONS ----- */
        .btn-primary {
            background: linear-gradient(135deg, #6366F1, #8B5CF6);
            color: white;
            font-weight: 600;
            padding: 16px 28px;
            border-radius: 60px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            box-shadow: 0 8px 28px rgba(99, 102, 241, 0.35);
            transition: all 0.25s cubic-bezier(0.2, 0.9, 0.4, 1);
            width: 100%;
            font-size: 16px;
            border: none;
            cursor: pointer;
            letter-spacing: 0.3px;
        }
        .btn-primary:active {
            transform: scale(0.96);
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.25);
        }
        .btn-primary:disabled {
            opacity: 0.5;
            pointer-events: none;
        }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-subtle);
            color: var(--text);
            font-weight: 500;
            padding: 14px;
            border-radius: 60px;
            transition: 0.25s ease;
            text-align: center;
            cursor: pointer;
            width: 100%;
            backdrop-filter: blur(4px);
        }
        .btn-secondary:active {
            background: rgba(255, 255, 255, 0.08);
            transform: scale(0.97);
        }
        .btn-secondary:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        /* ----- PROGRESS ----- */
        .progress-bar {
            background: #1E293B;
            height: 8px;
            border-radius: 20px;
            overflow: hidden;
            margin: 10px 0 6px;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #6366F1, #06B6D4);
            border-radius: 20px;
            transition: width 0.8s cubic-bezier(0.2, 0.9, 0.4, 1);
            position: relative;
        }
        .progress-fill::after {
            content: '';
            position: absolute;
            right: 0;
            top: 0;
            width: 20px;
            height: 100%;
            background: rgba(255, 255, 255, 0.2);
            filter: blur(6px);
            border-radius: 20px;
        }

        /* ----- STREAK BADGE ----- */
        .streak-badge {
            background: rgba(245, 158, 11, 0.12);
            color: var(--warning);
            padding: 6px 18px;
            border-radius: 40px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            border: 1px solid rgba(245, 158, 11, 0.15);
            backdrop-filter: blur(4px);
        }
        .streak-badge i {
            animation: pulseFire 1.5s infinite;
        }
        @keyframes pulseFire {
            0%,
            100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.2);
            }
        }

        /* ----- ACTIVITY HEATMAP ----- */
        .activity-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
            margin-top: 8px;
        }
        .activity-cell {
            aspect-ratio: 1;
            border-radius: 6px;
            background: #1E293B;
            transition: 0.2s;
            border: 1px solid transparent;
            position: relative;
        }
        .activity-cell.level0 {
            background: #1E293B;
        }
        .activity-cell.level1 {
            background: #1E3A5F;
        }
        .activity-cell.level2 {
            background: #2D4B7A;
        }
        .activity-cell.level3 {
            background: #4F7EB3;
        }
        .activity-cell.level4 {
            background: #7BA9E0;
        }
        .activity-cell:hover {
            border-color: var(--primary);
            transform: scale(1.05);
            z-index: 2;
        }

        /* ----- INPUT GROUPS ----- */
        .input-group {
            background: #1E293B;
            border-radius: 60px;
            padding: 4px 18px;
            display: flex;
            align-items: center;
            border: 1px solid var(--border-subtle);
            margin: 10px 0;
            transition: 0.25s;
        }
        .input-group:focus-within {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }
        .input-group i {
            color: var(--muted);
            margin-right: 14px;
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }
        .input-group input {
            width: 100%;
            padding: 14px 0;
            background: transparent;
            color: white;
            font-size: 14px;
            font-weight: 500;
        }
        .input-group input::placeholder {
            color: var(--muted);
            font-weight: 400;
        }

        /* ----- CHIPS ----- */
        .chip-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 12px 0 4px;
        }
        .chip {
            background: rgba(255, 255, 255, 0.04);
            padding: 6px 16px;
            border-radius: 40px;
            font-size: 12px;
            color: var(--muted);
            border: 1px solid transparent;
            font-weight: 500;
        }
        .chip.active {
            border-color: var(--primary);
            color: var(--text);
            background: rgba(99, 102, 241, 0.08);
        }

        /* ----- SCROLL X ----- */
        .scroll-x {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding: 4px 2px 12px;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
        }
        .scroll-x>* {
            flex: 0 0 auto;
            scroll-snap-align: start;
        }
        .scroll-x::-webkit-scrollbar {
            height: 3px;
        }
        .scroll-x::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 20px;
        }

        /* ----- CONFETTI ----- */
        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 999;
            overflow: hidden;
        }

        /* ----- EMPTY STATE ----- */
        .empty-state {
            text-align: center;
            padding: 40px 10px;
            color: var(--muted);
        }
        .empty-state i {
            font-size: 3.2rem;
            opacity: 0.25;
            margin-bottom: 12px;
        }

        /* ----- ANIMATIONS ----- */
        .fade-in {
            animation: fadeUp 0.6s cubic-bezier(0.2, 0.9, 0.4, 1) forwards;
            opacity: 0;
        }
        @keyframes fadeUp {
            0% {
                opacity: 0;
                transform: translateY(16px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .slide-up {
            animation: slideUp 0.5s cubic-bezier(0.2, 0.9, 0.4, 1) forwards;
        }
        @keyframes slideUp {
            0% {
                opacity: 0;
                transform: translateY(30px) scale(0.96);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .pulse-glow {
            animation: pulseGlow 2.4s infinite;
        }
        @keyframes pulseGlow {
            0% {
                box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.25);
            }
            50% {
                box-shadow: 0 0 0 14px rgba(99, 102, 241, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
            }
        }
        @keyframes confettiFall {
            0% {
                transform: translateY(0) rotate(0deg) scale(1);
                opacity: 1;
            }
            100% {
                transform: translateY(110vh) rotate(720deg) scale(0.3);
                opacity: 0;
            }
        }
        @keyframes float {
            0%,
            100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-8px);
            }
        }

        /* ----- RESPONSIVE ----- */
        @media (max-width: 480px) {
            .container {
                padding: 12px 14px;
            }
            .glass-card {
                padding: 16px 14px;
                border-radius: 20px;
            }
            .hero h1 {
                font-size: 2rem;
            }
            .stat-item .num {
                font-size: 1.4rem;
            }
            .day-header .day-num {
                font-size: 2.2rem;
            }
        }

        @media (min-width: 640px) {
            .container {
                max-width: 600px;
                padding: 24px 32px;
            }
            .bottom-nav {
                max-width: 600px;
                left: 50%;
                transform: translateX(-50%);
                border-radius: 60px 60px 0 0;
            }
        }

        @media (min-width: 1024px) {
            .container {
                max-width: 820px;
                padding: 32px 40px;
            }
            .bottom-nav {
                max-width: 720px;
            }
            .grid-2 {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 18px;
            }
            .grid-2 .glass-card {
                margin-bottom: 0;
            }
        }

        @media (min-width: 1280px) {
            .container {
                max-width: 1000px;
            }
            .bottom-nav {
                max-width: 860px;
            }
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr;
            gap: 18px;
        }
        @media (min-width: 768px) {
            .grid-2 {
                grid-template-columns: 1fr 1fr;
            }
            .grid-2 .glass-card {
                margin-bottom: 0;
            }
        }

        .flex-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .text-muted {
            color: var(--muted);
        }
        .text-center {
            text-align: center;
        }
        .fw-600 {
            font-weight: 600;
        }
        .mt-1 {
            margin-top: 8px;
        }
        .mb-1 {
            margin-bottom: 8px;
        }
        .gap-1 {
            gap: 8px;
        }
    </style>
</head>
