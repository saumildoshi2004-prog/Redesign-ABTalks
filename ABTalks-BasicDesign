                    </div>
                  `).join('')}
                  ${MOCK.badges.length === 0 ? `<div class="empty-state" style="padding:12px; font-size:0.85rem; width:100%;"><i class="fas fa-trophy"></i><p>No badges yet. Keep going!</p></div>` : ''}
                </div>
              </div>

              <div class="glass-card" style="background:linear-gradient(135deg, rgba(99,102,241,0.10), rgba(139,92,246,0.06)); border-color:rgba(99,102,241,0.1);">
                <p style="font-style:italic; font-weight:400; color:#E2E8F0; display:flex; gap:10px;">
                  <span style="color:var(--primary);">✨</span> “${moto}”
                </p>
              </div>
              <div style="height:10px;"></div>
            </div>
          `;
            document.getElementById('continueBtn')?.addEventListener('click', () => {
                currentPage = 'day';
                render();
            });
        }

        // ============================================================
        //  DAY PAGE — Fully working with 60 unique challenges
        // ============================================================
        function renderDay() {
            const challenge = getChallenge(currentDay);
            const isSubmitted = isDaySubmitted(currentDay);
            const prevSub = getSubmission(currentDay);

            if (!challenge) {
                app.innerHTML = `<div class="empty-state"><i class="fas fa-exclamation-circle"></i><p>Challenge not found!</p></div>`;
                return;
            }

            app.innerHTML = `
            <div class="fade-in">
              <div class="day-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <span class="day-num" style="font-size:2.6rem; font-weight:800; background:linear-gradient(135deg,#6366F1,#8B5CF6); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; letter-spacing:-1px;">Day ${challenge.day}</span>
                <span class="badge ${challenge.difficulty === 'Easy' ? 'success' : challenge.difficulty === 'Medium' ? 'warning' : 'danger'}">${challenge.difficulty}</span>
              </div>
              <h2 style="margin:4px 0 2px; font-size:1.3rem;">${challenge.title}</h2>
              <p style="color:var(--muted); font-size:0.85rem; margin-bottom:12px;">
                <i class="far fa-clock"></i> ${challenge.time} · ${challenge.objectives.join(' · ')}
              </p>

              <div class="glass-card">
                <h4 style="display:flex; gap:10px; align-items:center; font-size:0.95rem;">📖 Instructions</h4>
                <p style="color:#E2E8F0; font-size:0.95rem; margin:8px 0;">${challenge.instructions}</p>
                <div class="chip-group">
                  ${challenge.criteria.map(c => `<span class="chip active">${c}</span>`).join('')}
                </div>
                <div style="margin-top:10px;">
                  <span style="color:var(--muted); font-size:0.8rem; font-weight:500;">Resources:</span>
                  ${challenge.resources.map(r => `<span style="color:var(--primary-light); display:block; font-size:0.85rem; margin-top:2px;">📘 ${r}</span>`).join('')}
                </div>
                ${isSubmitted ? `<div class="badge success" style="margin-top:12px; display:inline-block;"><i class="fas fa-check-circle"></i> Submitted on Day ${challenge.day}</div>` : ''}
              </div>

              <div class="glass-card">
                <h4 style="display:flex; gap:10px; align-items:center; font-size:0.95rem;">📤 Submit your work</h4>
                <div class="input-group"><i class="fab fa-github"></i><input type="text" id="githubInput" placeholder="GitHub commit URL" value="${prevSub?.github || ''}"></div>
                <div class="input-group"><i class="fab fa-linkedin"></i><input type="text" id="linkedinInput" placeholder="LinkedIn post URL" value="${prevSub?.linkedin || ''}"></div>
                <button class="btn-primary" id="submitBtn" style="margin-top:10px;" ${isSubmitted ? 'disabled' : ''}>
                  <i class="fas ${isSubmitted ? 'fa-check-circle' : 'fa-paper-plane'}"></i>
                  ${isSubmitted ? '✅ Submitted' : 'Submit & earn XP'}
                </button>
                ${submissionStatus === 'success' ? `
                  <div class="slide-up" style="margin-top:14px; padding:12px; background:rgba(34,197,94,0.08); border-radius:16px; border-left:3px solid var(--success); display:flex; align-items:center; gap:12px;">
                    <i class="fas fa-confetti" style="color:var(--success); font-size:1.4rem;"></i>
                    <div><span style="color:var(--success); font-weight:600;">+50 XP</span> · Badge unlocked! 🎉</div>
                  </div>
                ` : ''}
                ${submissionStatus === 'error' ? `
                  <div class="slide-up" style="margin-top:14px; padding:12px; background:rgba(239,68,68,0.08); border-radius:16px; border-left:3px solid var(--danger); color:var(--danger);">
                    <i class="fas fa-exclamation-circle"></i> Invalid URL. Please include 'github.com' and 'linkedin.com'.
                  </div>
                ` : ''}
              </div>

              <div style="display:flex; gap:12px; margin:6px 0 12px;">
                <button class="btn-secondary" id="prevDay" style="flex:1;" ${currentDay <= 1 ? 'disabled' : ''}>
                  <i class="fas fa-arrow-left"></i> Previous
                </button>
                <button class="btn-secondary" id="nextDay" style="flex:1;" ${currentDay >= 60 ? 'disabled' : ''}>
                  Next <i class="fas fa-arrow-right"></i>
                </button>
              </div>

              <div style="display:flex; gap:16px; justify-content:center; color:var(--muted); font-size:0.85rem; padding:8px 0;">
                <span><i class="fas fa-star" style="color:var(--warning);"></i> +50 XP</span>
                <span><i class="fas fa-medal" style="color:var(--secondary);"></i> Streak badge</span>
              </div>
            </div>
          `;

            // ----- Event Listeners -----
            document.getElementById('submitBtn')?.addEventListener('click', () => {
                if (isDaySubmitted(currentDay)) return;

                const github = document.getElementById('githubInput').value.trim();
                const linkedin = document.getElementById('linkedinInput').value.trim();

                if (!github || !linkedin || !github.includes('github.com') || !linkedin.includes('linkedin.com')) {
                    submissionStatus = 'error';
                    renderDay();
                    return;
                }

                // Add submission
                MOCK.submissions.push({ day: currentDay, github, linkedin });
                MOCK.profile.xp += 50;

                // Update streak if consecutive
                if (currentDay === MOCK.profile.streak + 1) {
                    MOCK.profile.streak++;
                }

                // Add badge
                if (!MOCK.badges.find(b => b.name === 'Submission Master')) {
                    MOCK.badges.push({ name: 'Submission Master', icon: '📬', date: `Day ${currentDay}` });
                }

                // Update weekly activity
                const dayIndex = (currentDay - 1) % 7;
                if (MOCK.weeklyActivity[dayIndex] < 7) {
                    MOCK.weeklyActivity[dayIndex]++;
                }

                submissionStatus = 'success';
                launchConfetti();

                setTimeout(() => {
                    submissionStatus = null;
                    renderDay();
                }, 3000);

                renderDay();
            });

            document.getElementById('prevDay')?.addEventListener('click', () => {
                if (currentDay > 1) {
                    currentDay--;
                    submissionStatus = null;
                    renderDay();
                }
            });

            document.getElementById('nextDay')?.addEventListener('click', () => {
                if (currentDay < 60) {
                    currentDay++;
                    submissionStatus = null;
                    renderDay();
                }
            });
        }

        // ============================================================
        //  CONFETTI
        // ============================================================
        function launchConfetti() {
            const container = document.createElement('div');
            container.className = 'confetti-container';
            document.body.appendChild(container);
            const colors = ['#6366F1', '#8B5CF6', '#06B6D4', '#F59E0B', '#22C55E', '#EF4444', '#F1F5F9', '#EC4899'];
            for (let i = 0; i < 80; i++) {
                const el = document.createElement('div');
                const size = 5 + Math.random() * 10;
                const shape = Math.random() > 0.5 ? '50%' : '2px';
                el.style.cssText = `
              position: absolute;
              width: ${size}px;
              height: ${size}px;
              background: ${colors[Math.floor(Math.random() * colors.length)]};
              border-radius: ${shape};
              left: ${Math.random() * 100}%;
              top: -10%;
              opacity: ${0.6 + Math.random() * 0.4};
              animation: confettiFall ${2 + Math.random() * 2.5}s linear forwards;
              animation-delay: ${Math.random() * 0.4}s;
              transform: rotate(${Math.random() * 360}deg);
            `;
                container.appendChild(el);
            }
            setTimeout(() => container.remove(), 4500);
        }

        // ============================================================
        //  NAVIGATION
        // ============================================================
        document.querySelectorAll('.nav-item').forEach(el => {
            el.addEventListener('click', () => {
                const page = el.dataset.page;
                if (page === 'landing' || page === 'dashboard' || page === 'day') {
                    currentPage = page;
                    submissionStatus = null;
                    render();
                }
            });
        });

        // ============================================================
        //  INIT
        // ============================================================
        render();
    </script>
</body>
</html>
