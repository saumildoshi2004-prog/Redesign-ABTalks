function completionPercent(){return Math.round((completedCount()/60)*100);}
function nextIncompleteDay(){for(let d=1;d<=60;d++){if(!hasSubmitted(d))return d;}return 60;}
function xpTotal(){return completedCount()*50;}
function xpLevel(){return Math.floor(xpTotal()/500)+1;}
function xpIntoLevel(){return xpTotal()%500;}
function levelPercent(){return (xpIntoLevel()/500)*100;}
function careerReadiness(){return clamp(Math.round(state.profile.careerReadinessBase+(completedCount()/60)*60),0,98);}
function computeStreak(s){
  s=s||state;
  const dates=new Set(s.submissions.map(sub=>sub.submittedAt?sub.submittedAt.slice(0,10):null).filter(Boolean));
  let cursor=todayStart();
  if(!dates.has(dateKey(cursor))){cursor.setDate(cursor.getDate()-1);}
  let streak=0;
  while(dates.has(dateKey(cursor))){streak++;cursor.setDate(cursor.getDate()-1);}
  return streak;
}
