    function weeklyActivityData(){
      // Always show a different commit count for each day of the week (ups & downs).
      // Prefer live submission counts; if flat/empty, use varied demo commits.
      const days=[];
      for(let i=6;i>=0;i--){
        const d=todayStart(); d.setDate(d.getDate()-i);
        const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,"0"), day=String(d.getDate()).padStart(2,"0");
        const key=`${y}-${m}-${day}`;
        const count=state.submissions.filter(s=>{
          if(!s.submittedAt) return false;
          const raw=String(s.submittedAt);
          if(raw.slice(0,10)===key) return true;
          try{
            const sd=new Date(s.submittedAt);
            const sk=`${sd.getFullYear()}-${String(sd.getMonth()+1).padStart(2,"0")}-${String(sd.getDate()).padStart(2,"0")}`;
            return sk===key;
          }catch(e){ return false; }
        }).length;
        days.push(count);
      }
      const allZero=days.every(v=>v===0);
      const allSame=days.every(v=>v===days[0]);
      // Varied commits for each day: different height every day
      const DEMO_COMMITS=[3,1,5,2,4,0,3]; // M T W T F S S — each day different
      if(allZero || allSame){
        if(Array.isArray(state.weeklyActivity) && state.weeklyActivity.length>=7){
          const wa=state.weeklyActivity.slice(-7).map(v=>Number(v)||0);
          // ensure not flat
          if(!wa.every(v=>v===wa[0])) return wa;
        }
        return DEMO_COMMITS.slice();
      }
      return days;
    }

    /** Bar + line chart: each day is a different height so commits are obvious */
    function buildActivityChart(vals, opts){
      opts=opts||{};
      const W=opts.W||700, H=opts.H||220, PL=opts.PL||28, PR=opts.PR||14, PT=opts.PT||30, PB=opts.PB||34;
      const labels=opts.labels||['M','T','W','T','F','S','S'];
      const gid=opts.gid||('ac'+Math.random().toString(36).slice(2,7));
      // Force visible variation if somehow still flat
      let safe=vals.map(v=>Math.max(0,Number(v)||0));
      if(safe.length<7) while(safe.length<7) safe.push(0);
      if(safe.every(v=>v===safe[0])) safe=[3,1,5,2,4,0,3];
      const maxVal=Math.max(...safe,1);
      const max=Math.max(maxVal,1);
      const n=safe.length;
      const iw=W-PL-PR, ih=H-PT-PB;
      const gap=iw/n;
      const barW=Math.min(36, gap*0.55);
      const baseY=PT+ih;

      // Grid
      const grids=Array.from({length:5},(_,i)=>{
        const t=i/4;
        const y=PT+ih*(1-t);
        return `<line class="chart-grid" x1="${PL}" y1="${y}" x2="${W-PR}" y2="${y}"/>`;
      }).join('');

      // Bars — each day different height
      const bars=safe.map((v,i)=>{
        const cx=PL+gap*i+gap/2;
        const bh=max===0?0:(v/max)*ih;
        const x=cx-barW/2;
        const y=baseY-bh;
        const h=Math.max(bh, v>0?4:0);
        return `
          <rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW}" height="${h.toFixed(1)}"
            rx="8" ry="8" fill="url(#${gid}bar)" opacity="${v===0?0.25:0.95}"/>
          <text class="chart-value" text-anchor="middle" x="${cx.toFixed(1)}" y="${(y-8).toFixed(1)}">${v}</text>
          <text class="chart-label" text-anchor="middle" x="${cx.toFixed(1)}" y="${H-10}">${labels[i]||''}</text>
        `;
      }).join('');

      // Line + dots on top of bars
      const pts=safe.map((v,i)=>{
        const cx=PL+gap*i+gap/2;
        const cy=baseY-(v/max)*ih;
        return [cx, cy];
      });
      const line=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
      const dots=pts.map(p=>`<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="5" fill="#4aa3ff" stroke="#0b0d16" stroke-width="2.5"/>`).join('');

      return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" aria-label="Weekly commits by day">
        <defs>
          <linearGradient id="${gid}bar" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="#3b82f6" stop-opacity=".55"/>
            <stop offset="100%" stop-color="#22d3ee" stop-opacity="1"/>
          </linearGradient>
          <linearGradient id="${gid}g" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#22d3ee"/><stop offset="100%" stop-color="#6366f1"/>
          </linearGradient>
        </defs>
        ${grids}
        ${bars}
        <path d="${line}" fill="none" stroke="url(#${gid}g)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity=".85"/>
        ${dots}
      </svg>`;
    }

