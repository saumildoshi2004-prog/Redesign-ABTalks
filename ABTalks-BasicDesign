    const res=await window.storage.get(STORAGE_KEY,false);
    if(res&&res.value){
      const parsed=JSON.parse(res.value);
      return{...defaultState(),...parsed,profile:{...defaultState().profile,...(parsed.profile||{})}};
    }
  }catch(e){}
  return defaultState();
}
