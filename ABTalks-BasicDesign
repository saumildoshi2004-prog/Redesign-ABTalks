        if (newLevel > state.profile.level) {
          state.profile.level = newLevel;
          toast(`Level ${newLevel} unlocked!`, "🎉");
        }

        if (state.currentDay === state.profile.streak + 1) {
          state.profile.streak++;
        }

        state.profile.careerReadiness = Math.min(98, Math.round(38 + (state.submissions.length / 60) * 60));

